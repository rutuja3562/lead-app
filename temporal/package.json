{
  "name": "lead-app-temporal",
  "version": "1.0.0",
  "description": "Temporal workflows for lead onboarding",
  "scripts": {
    "build": "tsc",
    "start:worker": "ts-node src/workers/lead.worker.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.8.6",
    "@temporalio/client": "^1.8.6",
    "@temporalio/worker": "^1.8.6",
    "@temporalio/workflow": "^1.8.6"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.8.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.spec.ts"],
    "moduleFileExtensions": ["ts", "js", "json"]
  }
}
